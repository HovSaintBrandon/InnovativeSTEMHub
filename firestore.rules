rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Homepage settings (currently just the hero photo URL).
    match /profile/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Current research list.
    match /research/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Books & reads list.
    match /library/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blog posts — visitors only ever see published ones.
    match /blogPosts/{docId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    // Blog comments — anyone can post one, but it starts unapproved and is
    // only publicly visible once the admin approves it. Only the shape below
    // may be written by an anonymous visitor; everything else requires auth.
    match /blogComments/{docId} {
      allow read: if resource.data.approved == true || request.auth != null;

      allow create: if request.resource.data.approved == false
                    && request.resource.data.keys().hasOnly(['postId', 'name', 'comment', 'approved', 'createdAt'])
                    && request.resource.data.postId is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0
                    && request.resource.data.comment.size() < 2000;

      allow update, delete: if request.auth != null;
    }

    // Public contact form.
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /errorLogs/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
